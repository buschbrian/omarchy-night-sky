#!/usr/bin/env python3
"""Night sky for the Omarchy bar: sun, moon, twilight, Milky Way core, clouds and aurora.
Astronomy is standard-library only, deterministic and offline. Sun: Meeus ch. 25 low-precision
series. Moon: Meeus ch. 47 (30 largest terms per coordinate) with topocentric parallax.
Hourly cloud cover (Open-Meteo) and planetary Kp (NOAA SWPC) are fetched at most hourly and
cached in ~/.cache/night-sky; without a network the panel simply leaves those lanes out."""
import argparse
from datetime import date, datetime, time, timedelta, timezone
import json
import math
import os
from pathlib import Path
import sys
import urllib.parse
import urllib.request
from zoneinfo import ZoneInfo

LOCATIONS = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'omarchy/night-sky-locations.json'
MODES = {'milky-way': 'Milky Way', 'meteors': 'Meteors', 'aurora': 'Aurora', 'moonlit': 'Moonlit landscapes'}

OMARCHY_WEATHER = Path.home() / '.local/state/omarchy/settings/weather.json'


def system_tz():
    target = Path('/etc/localtime').resolve().as_posix()
    return target.split('/zoneinfo/', 1)[1] if '/zoneinfo/' in target else 'America/Denver'


DEFAULT_TZ = system_tz()
DELTA_T = 69.2  # TT - UT in seconds, 2026
AU_KM = 149597870.7
GC_RA_DEG = (17 + 45 / 60 + 40.04 / 3600) * 15  # Sgr A*, J2000
GC_DEC_DEG = -(29 + 28.1 / 3600)
CORE_MIN_ALT = 10.0
SUN_HORIZON = -0.833
ASTRO_TWILIGHT = -18.0
GOLDEN_HOUR = 6.0  # sun altitude where evening golden hour starts
BLUE_HOUR = -4.0   # golden hour ends and blue hour begins
CIVIL_TWILIGHT = -6.0  # blue hour ends
AURORA_KP = 6      # default: Kp a camera can catch low on the poleward horizon near 40-45° latitude
CLOUDY_PCT = 60    # mean cloud cover in the dark hours that earns a cloud on the pill
CLOUD_GLYPH = '\U000F0590'
AURORA_GLYPH = '\U000F0F2F'
CACHE = Path.home() / '.cache/night-sky'
CACHE_TTL = timedelta(hours=1)
AGENT = 'omarchy-night-sky (github.com/buschbrian/omarchy-night-sky)'
DATA = Path(__file__).resolve().parents[1] / 'data'
CURATED_URL = 'https://raw.githubusercontent.com/buschbrian/dark-sky-shot-planner/main/config/sky-events.json'
RADIANT_MIN_ALT = 10.0  # a shower radiant must clear this in darkness to count (planner ADR-0008)
KP_URL = 'https://services.swpc.noaa.gov/products/noaa-planetary-k-index-forecast.json'
REFRACTION_DEG = 34 / 60
MOON_RADIUS_KM = 1737.4

# Verdict thresholds (minutes)
GO_MIN_CORE = 30       # core above CORE_MIN_ALT in moon-free dark at least this long -> go
MIN_MOON_FREE = 30     # less moon-free dark than this -> the moon owns the night

PHASES = ['New Moon', 'Waxing Crescent', 'First Quarter', 'Waxing Gibbous',
          'Full Moon', 'Waning Gibbous', 'Last Quarter', 'Waning Crescent']
# Nerd Font Material Design moon glyphs, in PHASES order (render in the bar's theme colour)
GLYPHS = ['\U000F0F64', '\U000F0F67', '\U000F0F61', '\U000F0F68',
          '\U000F0F62', '\U000F0F66', '\U000F0F63', '\U000F0F65']

# D, M, M', F, sum_l (1e-6 deg), sum_r (1e-3 km)
MOON_LR = [
    (0, 0, 1, 0, 6288774, -20905355), (2, 0, -1, 0, 1274027, -3699111), (2, 0, 0, 0, 658314, -2955968),
    (0, 0, 2, 0, 213618, -569925), (0, 1, 0, 0, -185116, 48888), (0, 0, 0, 2, -114332, -3149),
    (2, 0, -2, 0, 58793, 246158), (2, -1, -1, 0, 57066, -152138), (2, 0, 1, 0, 53322, -170733),
    (2, -1, 0, 0, 45758, -204586), (0, 1, -1, 0, -40923, -129620), (1, 0, 0, 0, -34720, 108743),
    (0, 1, 1, 0, -30383, 104755), (2, 0, 0, -2, 15327, 10321), (0, 0, 1, 2, -12528, 0),
    (0, 0, 1, -2, 10980, 79661), (4, 0, -1, 0, 10675, -34782), (0, 0, 3, 0, 10034, -23210),
    (4, 0, -2, 0, 8548, -21636), (2, 1, -1, 0, -7888, 24208), (2, 1, 0, 0, -6766, 30824),
    (1, 0, -1, 0, -5163, -8379), (1, 1, 0, 0, 4987, -16675), (2, -1, 1, 0, 4036, -12831),
    (2, 0, 2, 0, 3994, -10445), (4, 0, 0, 0, 3861, -11650), (2, 0, -3, 0, 3665, 14403),
    (0, 1, -2, 0, -2689, -7003), (2, 0, -1, 2, -2602, 0), (2, -1, -2, 0, 2390, 10056),
]
# D, M, M', F, sum_b (1e-6 deg)
MOON_B = [
    (0, 0, 0, 1, 5128122), (0, 0, 1, 1, 280602), (0, 0, 1, -1, 277693), (2, 0, 0, -1, 173237),
    (2, 0, -1, 1, 55413), (2, 0, -1, -1, 46271), (2, 0, 0, 1, 32573), (0, 0, 2, 1, 17198),
    (2, 0, 1, -1, 9266), (0, 0, 2, -1, 8822), (2, -1, 0, -1, 8216), (2, 0, -2, -1, 4324),
    (2, 0, 1, 1, 4200), (2, 1, 0, -1, -3359), (2, -1, -1, 1, 2463), (2, -1, 0, 1, 2211),
    (2, -1, -1, -1, 2065), (0, 1, -1, -1, -1870), (4, 0, -1, -1, 1828), (0, 1, 0, 1, -1794),
    (0, 0, 0, 3, -1749), (0, 1, -1, 1, -1565), (1, 0, 0, 1, -1491), (0, 1, 1, 1, -1475),
    (0, 1, 1, -1, -1410), (0, 1, 0, -1, -1344), (1, 0, 0, -1, -1335), (0, 0, 3, 1, 1107),
    (4, 0, 0, -1, 1021), (4, 0, -1, 1, 833),
]

rad = math.radians
deg = math.degrees


def julian_day(t):
    return t.timestamp() / 86400 + 2440587.5


def centuries_tt(jd):
    return (jd + DELTA_T / 86400 - 2451545.0) / 36525


def mean_obliquity(T):
    return 23.439291 - 0.0130042 * T


def gmst_deg(jd):
    T = (jd - 2451545.0) / 36525
    return (280.46061837 + 360.98564736629 * (jd - 2451545.0) + 0.000387933 * T * T) % 360


def ecl_to_eq(lon, lat, eps):
    lon, lat, eps = rad(lon), rad(lat), rad(eps)
    ra = math.atan2(math.sin(lon) * math.cos(eps) - math.tan(lat) * math.sin(eps), math.cos(lon))
    dec = math.asin(math.sin(lat) * math.cos(eps) + math.cos(lat) * math.sin(eps) * math.sin(lon))
    return deg(ra) % 360, deg(dec)


def sun_position(jd):
    """Apparent ecliptic longitude (deg), distance (AU), RA/Dec (deg)."""
    T = centuries_tt(jd)
    L0 = 280.46646 + 36000.76983 * T + 0.0003032 * T * T
    M = rad(357.52911 + 35999.05029 * T - 0.0001537 * T * T)
    e = 0.016708634 - 0.000042037 * T
    C = ((1.914602 - 0.004817 * T - 0.000014 * T * T) * math.sin(M)
         + (0.019993 - 0.000101 * T) * math.sin(2 * M) + 0.000289 * math.sin(3 * M))
    nu = M + rad(C)
    R = 1.000001018 * (1 - e * e) / (1 + e * math.cos(nu))
    omega = rad(125.04 - 1934.136 * T)
    lon = (L0 + C - 0.00569 - 0.00478 * math.sin(omega)) % 360
    eps = mean_obliquity(T) + 0.00256 * math.cos(omega)
    ra, dec = ecl_to_eq(lon, 0.0, eps)
    return lon, R, ra, dec


def moon_position(jd):
    """Ecliptic longitude/latitude (deg), distance (km), RA/Dec (deg), geocentric."""
    T = centuries_tt(jd)
    Lp = 218.3164477 + 481267.88123421 * T - 0.0015786 * T * T
    D = rad(297.8501921 + 445267.1114034 * T - 0.0018819 * T * T)
    M = rad(357.5291092 + 35999.0502909 * T - 0.0001536 * T * T)
    Mp = rad(134.9633964 + 477198.8675055 * T + 0.0087414 * T * T)
    F = rad(93.2720950 + 483202.0175233 * T - 0.0036539 * T * T)
    A1 = rad(119.75 + 131.849 * T)
    A2 = rad(53.09 + 479264.290 * T)
    A3 = rad(313.45 + 481266.484 * T)
    E = 1 - 0.002516 * T - 0.0000074 * T * T
    sl = sr = sb = 0.0
    for d, m, mp, f, cl, cr in MOON_LR:
        arg = d * D + m * M + mp * Mp + f * F
        w = E ** abs(m)
        sl += cl * w * math.sin(arg)
        sr += cr * w * math.cos(arg)
    for d, m, mp, f, cb in MOON_B:
        sb += cb * E ** abs(m) * math.sin(d * D + m * M + mp * Mp + f * F)
    Lr = rad(Lp)
    sl += 3958 * math.sin(A1) + 1962 * math.sin(Lr - F) + 318 * math.sin(A2)
    sb += (-2235 * math.sin(Lr) + 382 * math.sin(A3) + 175 * math.sin(A1 - F) + 175 * math.sin(A1 + F)
           + 127 * math.sin(Lr - Mp) - 115 * math.sin(Lr + Mp))
    lon = (Lp + sl / 1e6) % 360
    lat = sb / 1e6
    dist = 385000.56 + sr / 1000
    ra, dec = ecl_to_eq(lon, lat, mean_obliquity(T))
    return lon, lat, dist, ra, dec


def altitude(ra, dec, jd, lat, lon):
    H = rad(gmst_deg(jd) + lon - ra)
    s = math.sin(rad(lat)) * math.sin(rad(dec)) + math.cos(rad(lat)) * math.cos(rad(dec)) * math.cos(H)
    return deg(math.asin(max(-1.0, min(1.0, s))))


def azimuth(ra, dec, jd, lat, lon):
    """Degrees east of north."""
    H = rad(gmst_deg(jd) + lon - ra)
    a = math.atan2(math.sin(H), math.cos(H) * math.sin(rad(lat)) - math.tan(rad(dec)) * math.cos(rad(lat)))
    return (deg(a) + 180) % 360


def compass(az):
    return ['N', 'NNE', 'NE', 'ENE', 'E', 'ESE', 'SE', 'SSE', 'S', 'SSW', 'SW', 'WSW', 'W', 'WNW', 'NW', 'NNW'][
        int((az + 11.25) % 360 // 22.5)]


def sun_altitude(t, lat, lon):
    jd = julian_day(t)
    _, _, ra, dec = sun_position(jd)
    return altitude(ra, dec, jd, lat, lon)


def moon_topocentric_altitude(jd, lat, lon):
    _, _, dist, ra, dec = moon_position(jd)
    u = math.atan(0.99664719 * math.tan(rad(lat)))
    rho_sin = 0.99664719 * math.sin(u)
    rho_cos = math.cos(u)
    sin_pi = 6378.14 / dist
    H = rad(gmst_deg(jd) + lon - ra)
    d = rad(dec)
    dra = math.atan2(-rho_cos * sin_pi * math.sin(H), math.cos(d) - rho_cos * sin_pi * math.cos(H))
    dec_t = math.atan2((math.sin(d) - rho_sin * sin_pi) * math.cos(dra),
                       math.cos(d) - rho_cos * sin_pi * math.cos(H))
    Ht = H - dra
    s = math.sin(rad(lat)) * math.sin(dec_t) + math.cos(rad(lat)) * math.cos(dec_t) * math.cos(Ht)
    semi = deg(math.asin(MOON_RADIUS_KM / dist))
    return deg(math.asin(s)), semi


def moon_rise_set_margin(t, lat, lon):
    """Upper-limb altitude above the refracted horizon; zero at moonrise/moonset."""
    alt, semi = moon_topocentric_altitude(julian_day(t), lat, lon)
    return alt + semi + REFRACTION_DEG


def core_altitude(t, lat, lon):
    # J2000 coordinates used as-is (no precession), matching the planner's golden vectors
    return altitude(GC_RA_DEG, GC_DEC_DEG, julian_day(t), lat, lon)


def crossings(fn, start, end, step=timedelta(minutes=10)):
    """[(time, +1 rising / -1 falling)] where fn changes sign, bisected to about a second."""
    out = []
    t0, v0 = start, fn(start)
    while t0 < end:
        t1 = min(t0 + step, end)
        v1 = fn(t1)
        if (v0 <= 0) != (v1 <= 0):
            lo, hi, vlo = t0, t1, v0
            for _ in range(24):
                mid = lo + (hi - lo) / 2
                vm = fn(mid)
                if (vm <= 0) == (vlo <= 0):
                    lo, vlo = mid, vm
                else:
                    hi = mid
            out.append((hi, 1 if v1 > 0 else -1))
        t0, v0 = t1, v1
    return out


def phase_info(t):
    jd = julian_day(t)
    slon, R, _, _ = sun_position(jd)
    mlon, mlat, dist, _, _ = moon_position(jd)
    elong = (mlon - slon) % 360
    psi = math.acos(math.cos(rad(mlat)) * math.cos(rad(elong)))
    i = math.atan2(R * AU_KM * math.sin(psi), dist - R * AU_KM * math.cos(psi))
    frac = (1 + math.cos(i)) / 2
    idx = int(((elong + 22.5) % 360) // 45)
    return {'fraction': frac, 'elongation': elong, 'name': PHASES[idx], 'glyph': GLYPHS[idx]}


def merge_runs(times, flags, step):
    spans, begin = [], None
    for t, up in zip(times, flags):
        if up and begin is None:
            begin = t
        elif not up and begin is not None:
            spans.append((begin, t))
            begin = None
    if begin is not None:
        spans.append((begin, times[-1] + step))
    return spans


def plan_night(lat, lon, search_start):
    """Night after search_start (UTC datetime): sun events, moon events, moon-free dark, core hours."""
    horizon = search_start + timedelta(hours=40)
    sun_h = lambda t: sun_altitude(t, lat, lon) - SUN_HORIZON
    sun_a = lambda t: sun_altitude(t, lat, lon) - ASTRO_TWILIGHT
    moon_h = lambda t: moon_rise_set_margin(t, lat, lon)

    sets = [t for t, d in crossings(sun_h, search_start, horizon) if d < 0]
    sunset = sets[0] if sets else None
    rises = [t for t, d in crossings(sun_h, sunset or search_start, horizon) if d > 0]
    sunrise = rises[0] if rises else None

    dusk = dawn = None
    a_cross = crossings(sun_a, search_start, horizon)
    falling = [t for t, d in a_cross if d < 0]
    if falling:
        dusk = falling[0]
        up_after = [t for t, d in a_cross if d > 0 and t > dusk]
        dawn = up_after[0] if up_after else None
    darkness = (dusk, dawn) if dusk and dawn else None

    w0 = sunset or search_start
    w1 = sunrise or horizon
    events = crossings(moon_h, w0, w1)
    result = {
        'sunset': sunset, 'sunrise': sunrise, 'darkness': darkness,
        'moonrises': [t for t, d in events if d > 0], 'moonsets': [t for t, d in events if d < 0],
        'moon_free': [], 'core_spans': [], 'phase_at': None,
    }
    mid = darkness[0] + (darkness[1] - darkness[0]) / 2 if darkness else w0 + (w1 - w0) / 2
    result['phase_at'] = mid
    if not darkness:
        return result

    d0, d1 = darkness
    moon_up = moon_h(d0) > 0
    cursor, free = d0, []
    for t, d in crossings(moon_h, d0, d1):
        if d > 0:
            if not moon_up and t > cursor:
                free.append((cursor, t))
            moon_up = True
        else:
            moon_up, cursor = False, t
    if not moon_up and d1 > cursor:
        free.append((cursor, d1))
    result['moon_free'] = [(a, b) for a, b in free if (b - a) > timedelta(minutes=1)]

    step = timedelta(minutes=1)
    for a, b in result['moon_free']:
        times, t = [], a
        while t < b:
            times.append(t)
            t += step
        flags = [core_altitude(x, lat, lon) > CORE_MIN_ALT for x in times]
        for s, e in merge_runs(times, flags, step):
            result['core_spans'].append((s, min(e, b)))
    return result


def minutes(span):
    return (span[1] - span[0]).total_seconds() / 60


def hm(mins):
    mins = int(round(mins))
    return f'{mins // 60}h{mins % 60:02d}m'


def verdict(plan, illum):
    """Rule order: no dark -> no moon-free dark -> core up long enough -> dark without core."""
    if not plan['darkness']:
        return 'none', 'No astronomical darkness tonight'
    free = max((minutes(w) for w in plan['moon_free']), default=0)
    pct = round(illum * 100)
    if free < MIN_MOON_FREE:
        return 'skip', f'Moon {pct}% - skip core shots'
    core = plan['core_spans']
    if sum(minutes(s) for s in core) >= GO_MIN_CORE:
        best = max(core, key=minutes)
        return 'go', f'Go: {hm(free)} moon-free dark, core up {fmt_time(best[0], plan)}-{fmt_time(best[1], plan)}'
    up = sum(minutes(s) for s in core)
    note = f'core up only {round(up)}m' if up else f'core below {CORE_MIN_ALT:.0f}deg'
    return 'dark', f'{hm(free)} moon-free dark, {note} - no core shots'


def fmt_time(t, plan):
    return t.astimezone(plan['tz']).strftime('%H:%M')


def iso(t, tz):
    return t.astimezone(tz).isoformat(timespec='seconds') if t else None


def tonight(lat, lon, day, tz_name=DEFAULT_TZ):
    tz = ZoneInfo(tz_name)
    start = datetime.combine(day, time(12, 0), tzinfo=tz).astimezone(timezone.utc)
    plan = plan_night(lat, lon, start)
    plan['tz'] = tz
    phase = phase_info(plan['phase_at'])
    key, line = verdict(plan, phase['fraction'])
    free = max((minutes(w) for w in plan['moon_free']), default=0)
    core = plan['core_spans']
    dark = plan['darkness']
    return {
        'date': day.isoformat(),
        'location': {'lat': lat, 'lon': lon, 'tz': tz_name},
        'moon': {
            'phase': phase['name'], 'glyph': phase['glyph'],
            'illumination_pct': round(phase['fraction'] * 100),
            'fraction': round(phase['fraction'], 3), 'waxing': phase['elongation'] < 180,
            'moonrise': iso(plan['moonrises'][0] if plan['moonrises'] else None, tz),
            'moonset': iso(plan['moonsets'][0] if plan['moonsets'] else None, tz),
        },
        'sunset': iso(plan['sunset'], tz),
        'astro_twilight_end': iso(dark[0] if dark else None, tz),
        'astro_dawn_start': iso(dark[1] if dark else None, tz),
        'sunrise': iso(plan['sunrise'], tz),
        'moon_free_dark': [{'start': iso(a, tz), 'end': iso(b, tz), 'minutes': round(minutes((a, b)))}
                           for a, b in plan['moon_free']],
        'moon_free_minutes': round(free),
        'milky_way_core': {
            'min_altitude_deg': CORE_MIN_ALT,
            'minutes': round(sum(minutes(s) for s in core)),
            'windows': [{'start': iso(a, tz), 'end': iso(b, tz), 'minutes': round(minutes((a, b)))}
                        for a, b in core],
        },
        'verdict': line,
        'verdict_class': key,
        '_plan': plan,
    }


def sky_band(alt):
    if alt > GOLDEN_HOUR:
        return 'day'
    if alt > BLUE_HOUR:
        return 'golden'
    if alt > CIVIL_TWILIGHT:
        return 'blue'
    return 'twilight' if alt > ASTRO_TWILIGHT else 'dark'


def timeline(plan, lat, lon, clouds=None, kp=None):
    """Evening golden hour to the end of morning golden hour: sky bands from exact sun-altitude
    crossings, sun/moon/core altitude curves, and cloud and Kp bins, all as 0-1 fractions."""
    tz = plan['tz']
    sunset, sunrise, dark = plan['sunset'], plan['sunrise'], plan['darkness']
    if not sunset:
        return None
    sun_g = lambda t: sun_altitude(t, lat, lon) - GOLDEN_HOUR
    falling = [t for t, d in crossings(sun_g, sunset - timedelta(hours=3), sunset) if d < 0]
    w0 = falling[-1] if falling else sunset - timedelta(minutes=45)
    end = sunrise or (dark[1] if dark else sunset + timedelta(hours=14))
    rising = [t for t, d in crossings(sun_g, end, end + timedelta(hours=3)) if d > 0]
    w1 = rising[0] if rising else end + timedelta(minutes=45)
    total = (w1 - w0).total_seconds()
    frac = lambda t: round(min(max((t - w0).total_seconds() / total, 0), 1), 4)
    clock = lambda t: fmt_time(t, plan)

    marks = {}
    for thr in (BLUE_HOUR, CIVIL_TWILIGHT, ASTRO_TWILIGHT, SUN_HORIZON):
        for t, d in crossings(lambda t: sun_altitude(t, lat, lon) - thr, w0, w1):
            marks[(thr, 'down' if d < 0 else 'up')] = t
    edges = sorted({w0, w1, *(t for (thr, _), t in marks.items() if thr != SUN_HORIZON)})
    sky = []
    for a, b in zip(edges, edges[1:]):
        kind = sky_band(sun_altitude(a + (b - a) / 2, lat, lon))
        if sky and sky[-1]['kind'] == kind:
            sky[-1].update(end=clock(b), b=frac(b))
        else:
            sky.append({'kind': kind, 'start': clock(a), 'end': clock(b), 'a': frac(a), 'b': frac(b)})

    def span(kind, a, b):
        a, b = max(a, w0), min(b, w1)
        return {'kind': kind, 'start': clock(a), 'end': clock(b), 'a': frac(a), 'b': frac(b)}

    moon_h = lambda t: moon_rise_set_margin(t, lat, lon)
    moon, up, cursor = [], moon_h(w0) > 0, w0
    for t, d in crossings(moon_h, w0, w1):
        if d < 0 and up:
            moon.append(span('moon', cursor, t))
        up, cursor = d > 0, t
    if up:
        moon.append(span('moon', cursor, w1))

    curves = {'sun': [], 'moon': [], 'core': []}
    times = []
    samples = minute_range(w0, w1, 10)
    if samples[-1] < w1:
        samples.append(w1)
    for t in samples:
        times.append(clock(t))
        jd = julian_day(t)
        curves['sun'].append([frac(t), round(sun_altitude(t, lat, lon), 1)])
        curves['moon'].append([frac(t), round(moon_topocentric_altitude(jd, lat, lon)[0], 1)])
        curves['core'].append([frac(t), round(core_altitude(t, lat, lon), 1)])

    def at(key):
        t = marks.get(key)
        return clock(t) if t else '--'

    events = {
        'evening': {'golden': clock(w0), 'sunset': clock(sunset), 'blue': at((BLUE_HOUR, 'down')),
                    'blue_end': at((CIVIL_TWILIGHT, 'down')), 'dark': at((ASTRO_TWILIGHT, 'down'))},
        'morning': {'dawn': at((ASTRO_TWILIGHT, 'up')), 'blue': at((CIVIL_TWILIGHT, 'up')),
                    'golden': at((BLUE_HOUR, 'up')), 'sunrise': clock(sunrise) if sunrise else '--',
                    'golden_end': clock(w1)},
    }

    pool = [x for a, b in plan['core_spans'] for x in minute_range(a, b, 5)]
    if not pool and dark:
        pool = minute_range(*dark, 5)
    best = max(pool, key=lambda x: core_altitude(x, lat, lon), default=None)
    core_best = None
    if best and core_altitude(best, lat, lon) > 0:
        az = azimuth(GC_RA_DEG, GC_DEC_DEG, julian_day(best), lat, lon)
        core_best = {'time': clock(best), 'alt': round(core_altitude(best, lat, lon)), 'az': round(az),
                     'dir': compass(az), 'moon_free': bool(plan['core_spans'])}
    moon_dir = None
    rise = next((t for t, d in crossings(moon_h, w0, w1) if d > 0), None)
    if rise:
        _, _, _, ra, dec = moon_position(julian_day(rise))
        az = azimuth(ra, dec, julian_day(rise), lat, lon)
        moon_dir = {'time': clock(rise), 'az': round(az), 'dir': compass(az), 'event': 'rise'}

    cloud_bins = []
    for hour in clouds or []:
        a = datetime.fromisoformat(hour['time']).replace(tzinfo=timezone.utc)
        if a + timedelta(hours=1) > w0 and a < w1:
            cloud_bins.append({**span('cloud', a, a + timedelta(hours=1)),
                               **{k: hour.get(k) for k in ('total', 'low', 'mid', 'high', 'jet')}})
    window = dark or (sunset, end)
    in_dark = [c['total'] for c in clouds or []
               if c.get('total') is not None and window[0] - timedelta(hours=1) < datetime.fromisoformat(c['time']).replace(tzinfo=timezone.utc) < window[1]]

    kp_bins = []
    for row in kp or []:
        a = datetime.fromisoformat(row['time']).replace(tzinfo=timezone.utc)
        if a + timedelta(hours=3) > w0 and a < w1:
            kp_bins.append({**span('kp', a, a + timedelta(hours=3)), 'kp': row['kp'],
                            'scale': row.get('scale'), 'observed': row.get('observed')})

    ticks, t = [], w0.astimezone(tz).replace(minute=0, second=0, microsecond=0) + timedelta(hours=1)
    while t < w1:
        if t.hour % 2 == 0:
            ticks.append({'label': t.strftime('%H'), 'at': frac(t)})
        t += timedelta(hours=1)
    return {'start_ms': int(w0.timestamp() * 1000), 'end_ms': int(w1.timestamp() * 1000),
            'sky': sky, 'moon': moon, 'core': [span('core', a, b) for a, b in plan['core_spans']],
            'curves': curves, 'times': times, 'events': events, 'core_best': core_best, 'moon_dir': moon_dir,
            'clouds': cloud_bins if clouds else None,
            'cloud_pct': round(sum(in_dark) / len(in_dark)) if in_dark else None,
            'kp': kp_bins if kp else None,
            'kp_max': max((k['kp'] for k in kp_bins), default=None) if kp else None,
            'ticks': ticks}


def minute_range(a, b, step):
    out, t = [], a
    while t <= b:
        out.append(t)
        t += timedelta(minutes=step)
    return out


def cached_json(name, url, ttl, now, parse):
    """GET url as JSON through a cache file: (data, fetched_iso); the stale copy when offline."""
    path = CACHE / name
    try:
        cached = json.loads(path.read_text())
        if now - datetime.fromisoformat(cached['fetched']) < ttl:
            return cached['data'], cached['fetched']
    except (OSError, ValueError, KeyError):
        cached = None
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': AGENT}), timeout=8) as r:
            data = parse(json.load(r))
    except (OSError, ValueError, KeyError, TypeError):
        return (cached['data'], cached['fetched']) if cached else (None, None)
    CACHE.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({'fetched': now.isoformat(), 'data': data}))
    return data, now.isoformat()


def load_conditions(lat, lon, now=None):
    """Hourly cloud layers, gusts, temperature, dew point and 250 hPa wind (Open-Meteo, 16 days),
    with aerosol optical depth (Open-Meteo air quality, about 5 days). Returns (hours, fetched_iso)."""
    now = now or datetime.now(timezone.utc)
    where = {'latitude': f'{lat:.4f}', 'longitude': f'{lon:.4f}', 'timezone': 'UTC', 'past_days': 1}
    fields = ['cloud_cover', 'cloud_cover_low', 'cloud_cover_mid', 'cloud_cover_high', 'wind_gusts_10m',
              'temperature_2m', 'dew_point_2m', 'wind_speed_250hPa']
    keys = ['total', 'low', 'mid', 'high', 'gust', 'temp', 'dew', 'jet']

    def parse_forecast(body):
        h = body['hourly']
        return [dict(time=t, **{k: h[f][i] for k, f in zip(keys, fields)}) for i, t in enumerate(h['time'])]

    forecast, fetched = cached_json(
        f'forecast-{lat:.4f}-{lon:.4f}.json',
        'https://api.open-meteo.com/v1/forecast?' + urllib.parse.urlencode(
            {**where, 'forecast_days': 16, 'hourly': ','.join(fields)}),
        CACHE_TTL, now, parse_forecast)
    if not forecast:
        return None, None
    aod, aod_fetched = cached_json(
        f'aod-{lat:.4f}-{lon:.4f}.json',
        'https://air-quality-api.open-meteo.com/v1/air-quality?' + urllib.parse.urlencode(
            {**where, 'forecast_days': 7, 'hourly': 'aerosol_optical_depth'}),
        CACHE_TTL, now,
        lambda body: dict(zip(body['hourly']['time'], body['hourly']['aerosol_optical_depth'])))
    return [dict(h, aod=(aod or {}).get(h['time'])) for h in forecast], {'clouds': fetched, 'haze': aod_fetched}


def load_bundled_curated():
    try:
        return json.loads((DATA / 'sky-events.json').read_text())['events']
    except (OSError, ValueError, KeyError):
        return []


def load_curated(now=None):
    """The planner's hand-curated showers and festivals, refreshed daily from its repo, else bundled."""
    now = now or datetime.now(timezone.utc)
    data, _ = cached_json('sky-events.json', CURATED_URL, timedelta(days=1), now, lambda body: body['events'])
    return data if data is not None else load_bundled_curated()


# ---- Shoot verdict: the planner's worst-gating-factor rule over the moon-free dark window

def thresholds():
    factors = json.loads((DATA / 'conditions-thresholds.json').read_text())['factors']
    factors['jet_stream'] = {'label': 'Jet stream, 250 hPa (seeing proxy)', 'unit': 'km/h', 'better': 'lower',
                             'good': 70, 'marginal': 110, 'gates_verdict': False}
    return factors


SHORT = {'moon_free_minutes': 'moon', 'cloud_cover_total': 'clouds', 'cloud_cover_max_hour': 'cloud peak',
         'aerosol_optical_depth': 'haze', 'wind_gust': 'gusts', 'dew_point_spread': 'dew',
         'gc_max_altitude': 'core', 'jet_stream': 'jet stream'}


def rate(value, spec):
    if value is None:
        return 'unavailable'
    good, marginal = spec.get('good'), spec.get('marginal')
    if good is None or marginal is None:
        return 'shown'
    if spec['better'] == 'higher':
        return 'good' if value >= good else 'marginal' if value >= marginal else 'poor'
    return 'good' if value <= good else 'marginal' if value <= marginal else 'poor'


def hours_in(hours, windows):
    out = []
    for h in hours or []:
        a = datetime.fromisoformat(h['time']).replace(tzinfo=timezone.utc)
        if any(a < w1 and a + timedelta(hours=1) > w0 for w0, w1 in windows):
            out.append(h)
    return out


def fmt_value(key, value, unit):
    if value is None:
        return '—'
    if key == 'moon_free_minutes':
        return f'{int(value) // 60}h{int(value) % 60:02d}'
    if key == 'aerosol_optical_depth':
        return f'{value:.2f}'
    return f'{value:.0f}{"" if unit in ("", "%", "°") else " "}{unit}'


def source_time(fetched, name):
    return fetched.get(name) if isinstance(fetched, dict) else fetched


def source_status(fetched, available, now):
    age = (now - datetime.fromisoformat(fetched)).total_seconds() if fetched else None
    return {'updated': fetched, 'available': available, 'stale': age is None or age > 6 * 3600}


def target_windows(plan, lat, lon, mode, curated=None):
    if mode == 'milky-way':
        return plan['core_spans'], 'Milky Way core'
    if mode == 'aurora':
        return [plan['darkness']] if plan['darkness'] else [], 'Poleward horizon'
    if mode == 'meteors':
        # The observing night starts on the evening date, even when its midpoint is after midnight.
        day = evening_of(plan['phase_at'], plan['tz'])
        showers = [e for e in curated or [] if e.get('kind') == 'meteor_shower'
                   and e.get('active_from', '9999') <= day.isoformat() <= e.get('active_to', '')
                   and e.get('radiant_ra_hours') is not None and e.get('radiant_dec_deg') is not None]
        shower = max(showers, key=lambda e: (e.get('zhr') or 0, e['name']), default=None)
        if not shower:
            return [], 'No active curated shower'
        def qualifies(t):
            ra, dec = precess(shower['radiant_ra_hours'] * 15, shower['radiant_dec_deg'], t)
            return altitude(ra, dec, julian_day(t), lat, lon) >= RADIANT_MIN_ALT
        spans = plan['moon_free']
        label = shower['name'] + (' (unverified)' if not shower.get('verified_on') else '')
    else:
        if not plan['sunset'] or not plan['sunrise']:
            return [], 'No night interval'
        spans = [(plan['sunset'], plan['sunrise'])]
        def qualifies(t):
            return (sun_altitude(t, lat, lon) <= CIVIL_TWILIGHT
                    and moon_rise_set_margin(t, lat, lon) > 0 and phase_info(t)['fraction'] >= 0.1)
        label = 'Moon above horizon, at least 10% lit'
    out, step = [], timedelta(minutes=5)
    for a, b in spans:
        times = minute_range(a, b - step, 5)
        for start, end in merge_runs(times, [qualifies(t + step / 2) for t in times], step):
            out.append((start, min(end, b)))
    return out, label


def condition_at(hours, t):
    return next((h for h in hours or [] if datetime.fromisoformat(h['time']).replace(tzinfo=timezone.utc)
                 <= t < datetime.fromisoformat(h['time']).replace(tzinfo=timezone.utc) + timedelta(hours=1)), None)


def kp_at(kp, t):
    return next((k['kp'] for k in kp or [] if datetime.fromisoformat(k['time']).replace(tzinfo=timezone.utc)
                 <= t < datetime.fromisoformat(k['time']).replace(tzinfo=timezone.utc) + timedelta(hours=3)), None)


def shoot_verdict(plan, report, lat, lon, hours, fetched=None, kp_max=None, aurora_kp=AURORA_KP,
                  now=None, mode=None, windows=None, curated=None):
    now = now or datetime.now(timezone.utc)
    specs = thresholds()
    if windows is None:
        windows = target_windows(plan, lat, lon, mode, curated)[0] if mode else plan['moon_free'] or ([plan['darkness']] if plan['darkness'] else [])
    if not windows:
        why = {'milky-way': 'no moon-free core window', 'meteors': 'no active shower window',
               'moonlit': 'no moonlit window', 'aurora': 'no astronomical darkness'}.get(mode, 'no astronomical darkness')
        return {'level': 'no-go', 'headline': 'No-go · ' + why, 'factors': [],
                'incomplete': False, 'stale': False, 'aurora': False}
    inside = hours_in(hours, windows)
    samples = [t + timedelta(minutes=2.5) for a, b in windows for t in minute_range(a, b - timedelta(minutes=5), 5)]
    covered = [condition_at(hours, t) for t in samples]

    def pick(key, fn):
        values = [h[key] for h in covered if h and h.get(key) is not None]
        return fn(values) if values else None

    spread = [h['temp'] - h['dew'] for h in inside if h.get('temp') is not None and h.get('dew') is not None]
    core = [core_altitude(t, lat, lon) for t in samples]
    values = {
        'moon_free_minutes': report['moon_free_minutes'],
        'cloud_cover_total': pick('total', lambda v: sum(v) / len(v)),
        'cloud_cover_max_hour': pick('total', max),
        'aerosol_optical_depth': pick('aod', lambda v: sum(v) / len(v)),
        'wind_gust': pick('gust', max),
        'dew_point_spread': min(spread) if spread else None,
        'gc_max_altitude': max(core) if core else None,
        'jet_stream': pick('jet', max),
    }
    if mode:
        specs['shoot_minutes'] = {'label': 'Target window', 'unit': 'min', 'better': 'higher',
                                  'good': 60, 'marginal': 30, 'gates_verdict': True}
        values['shoot_minutes'] = max((minutes(w) for w in windows), default=0)
        specs['moon_free_minutes']['gates_verdict'] = False
        specs['gc_max_altitude']['gates_verdict'] = mode == 'milky-way'
    factors, order = [], ['poor', 'marginal', 'good']
    for key, value in values.items():
        spec = specs[key]
        factors.append({'key': key, 'label': spec['label'], 'value': fmt_value(key, value, spec['unit']),
                        'rating': rate(value, spec), 'gates': bool(spec['gates_verdict'])})
    gating = [f for f in factors if f['gates']]
    rated = [f for f in gating if f['rating'] in order]
    worst = min(rated, key=lambda f: order.index(f['rating'])) if rated else None
    level = {'poor': 'no-go', 'marginal': 'marginal', 'good': 'go'}[worst['rating']] if worst else 'marginal'
    incomplete = any(f['rating'] == 'unavailable' for f in gating) or not samples or any(
        not h or any(h.get(k) is None for k in ('total', 'aod', 'gust')) for h in covered)
    stale = any((isinstance(fetched, dict) and not source_time(fetched, name)) or
                (source_time(fetched, name) and now - datetime.fromisoformat(source_time(fetched, name))
                 > timedelta(hours=6)) for name in ('clouds', 'haze'))
    if (incomplete or stale) and level == 'go':
        level = 'marginal'
    if worst and worst['rating'] != 'good':
        why = f"{SHORT.get(worst['key'], 'window')} {worst['value']}"
    elif incomplete:
        why = 'incomplete data'
    elif stale:
        why = 'forecast is over 6 h old'
    else:
        why = ''
    head = {'go': 'Go', 'marginal': 'Marginal', 'no-go': 'No-go'}[level]
    return {'level': level, 'headline': f'{head} · {why}' if why else head, 'factors': factors,
            'incomplete': incomplete, 'stale': stale, 'aurora': kp_max is not None and kp_max >= aurora_kp}


def best_window(plan, report, lat, lon, hours, fetched, kp, mode, curated, aurora_kp, now):
    targets, subject = target_windows(plan, lat, lon, mode, curated)
    specs = thresholds()
    step = timedelta(minutes=5)
    runs = []
    for a, b in targets:
        a = max(a, now)  # Never recommend an interval that has already passed.
        times = minute_range(a, b - step, 5)
        ratings = []
        for t in times:
            h = condition_at(hours, t + step / 2)
            weather = [rate(h.get(key) if h else None, specs[spec]) for key, spec in
                       [('total', 'cloud_cover_total'), ('gust', 'wind_gust'), ('aod', 'aerosol_optical_depth')]]
            k = kp_at(kp, t + step / 2)
            eligible = mode != 'aurora' or k is not None and k >= aurora_kp
            ratings.append((eligible, weather))
        for good_only in (True, False):
            flags = [eligible and (all(r == 'good' for r in weather) if good_only else 'poor' not in weather)
                     for eligible, weather in ratings]
            runs.extend(merge_runs(times, flags, step))
    candidates = []
    for a, b in sorted(set(runs)):
        if minutes((a, b)) < 30:
            continue
        v = shoot_verdict(plan, report, lat, lon, hours, fetched, aurora_kp=aurora_kp, now=now,
                          mode=mode, windows=[(a, b)], curated=curated)
        if mode == 'aurora':
            status = source_status(source_time(fetched, 'kp'), bool(kp), now)
            v['stale'] = v['stale'] or status['stale']
            if status['stale'] and v['level'] == 'go':
                v.update(level='marginal', headline='Marginal · stale Kp data')
        candidates.append((v, a, b))
    best = max(candidates, key=lambda x: ({'go': 2, 'marginal': 1, 'no-go': 0}[x[0]['level']],
                                         not x[0]['incomplete'] and not x[0]['stale'],
                                         minutes((x[1], x[2])), -x[1].timestamp()), default=None)
    if not best:
        return None
    v, a, b = best
    mid = a + (b - a) / 2
    direction = 'N' if lat >= 0 else 'S'
    if mode == 'milky-way':
        direction = compass(azimuth(GC_RA_DEG, GC_DEC_DEG, julian_day(mid), lat, lon))
    elif mode == 'moonlit':
        _, _, _, ra, dec = moon_position(julian_day(mid))
        direction = compass(azimuth(ra, dec, julian_day(mid), lat, lon))
    elif mode == 'meteors':
        direction = 'wide sky'
    cloud = next((f['value'] for f in v['factors'] if f['key'] == 'cloud_cover_total'), '—')
    return {'start': iso(a, plan['tz']), 'end': iso(b, plan['tz']), 'start_ms': int(a.timestamp() * 1000),
            'end_ms': int(b.timestamp() * 1000), 'minutes': round(minutes((a, b))), 'level': v['level'],
            'headline': f"{fmt_time(a, plan)}–{fmt_time(b, plan)} · {v['headline']} · clouds {cloud} · {direction}",
            'subject': subject, 'direction': direction, 'factors': v['factors'],
            'incomplete': v['incomplete'], 'stale': v['stale']}


def week(lat, lon, day, hours, fetched, tz_name, kp=None, aurora_kp=AURORA_KP,
         mode=None, curated=None, now=None):
    now = now or datetime.now(timezone.utc)
    out = []
    for d in range(7):
        night = day + timedelta(days=d)
        rep = tonight(lat, lon, night, tz_name)
        plan = rep['_plan']
        dark = [plan['darkness']] if plan['darkness'] else []
        kp_in = [k['kp'] for k in kp or []
                 if dark and dark[0][0] - timedelta(hours=3) < datetime.fromisoformat(k['time']).replace(tzinfo=timezone.utc) < dark[0][1]]
        v = shoot_verdict(plan, rep, lat, lon, hours, fetched, max(kp_in) if kp_in else None, aurora_kp,
                          now=now, mode=mode, curated=curated)
        best = best_window(plan, rep, lat, lon, hours, fetched, kp, mode, curated, aurora_kp, now) if mode else None
        cloud = next((f['value'] for f in v['factors'] if f['key'] == 'cloud_cover_total'), '—')
        out.append({'date': night.isoformat(), 'day': night.strftime('%a'), 'level': v['level'],
                    'headline': v['headline'], 'incomplete': v['incomplete'], 'aurora': v['aurora'],
                    'moon_free_minutes': rep['moon_free_minutes'], 'cloud': cloud, 'best_window': best,
                    'illumination_pct': rep['moon']['illumination_pct'], 'glyph': rep['moon']['glyph']})
    eligible = [n for n in out if n['best_window'] and n['best_window']['level'] != 'no-go'
                and not n['best_window']['incomplete'] and not n['best_window']['stale']]
    best = max(eligible, key=lambda n: ({'go': 2, 'marginal': 1}[n['best_window']['level']],
                                       n['best_window']['minutes']), default=None)
    for n in out:
        n['recommended'] = n is best
    return out


# ---- Milky Way core rise, transit and set

def core_times(plan, lat, lon):
    centre = plan['phase_at']
    start, end = centre - timedelta(hours=12), centre + timedelta(hours=12)
    alt = lambda t: core_altitude(t, lat, lon)
    tz = plan['tz']

    def point(t):
        jd = julian_day(t)
        az = azimuth(GC_RA_DEG, GC_DEC_DEG, jd, lat, lon)
        return {'time': t.astimezone(tz).strftime('%H:%M'), 'az': round(az), 'dir': compass(az),
                'alt': round(alt(t))}

    events = crossings(alt, start, end)
    rise = next((t for t, d in events if d > 0), None)
    set_ = next((t for t, d in events if d < 0 and (rise is None or t > rise)), None)
    samples = minute_range(start, end, 5)
    top = max(samples, key=alt)
    if alt(top) <= 0:
        return None
    return {'rise': point(rise) if rise else None, 'transit': point(top), 'set': point(set_) if set_ else None}


# ---- Sky events: moon phases, seasons, curated showers judged here, festivals

def precess(ra_deg, dec_deg, t):
    """J2000 to the equinox of date (Meeus 21.2)."""
    T = (julian_day(t) - 2451545.0) / 36525
    zeta = rad((2306.2181 * T + 0.30188 * T * T + 0.017998 * T ** 3) / 3600)
    z = rad((2306.2181 * T + 1.09468 * T * T + 0.018203 * T ** 3) / 3600)
    theta = rad((2004.3109 * T - 0.42665 * T * T - 0.041833 * T ** 3) / 3600)
    a0, d0 = rad(ra_deg), rad(dec_deg)
    A = math.cos(d0) * math.sin(a0 + zeta)
    B = math.cos(theta) * math.cos(d0) * math.cos(a0 + zeta) - math.sin(theta) * math.sin(d0)
    C = math.sin(theta) * math.cos(d0) * math.cos(a0 + zeta) + math.cos(theta) * math.sin(d0)
    return (deg(math.atan2(A, B) + z)) % 360, deg(math.asin(C))


def angle_events(fn, targets, names, start, end):
    """Times when an increasing angle (degrees) passes each target."""
    out = []
    for target, name in zip(targets, names):
        wrapped = lambda t, g=target: ((fn(t) - g + 180) % 360) - 180
        for t, d in crossings(wrapped, start, end, timedelta(hours=6)):
            if d > 0 and abs(wrapped(t)) < 1:
                out.append((t, name))
    return out


def evening_of(t, tz):
    local = t.astimezone(tz)
    return (local - timedelta(days=1)).date() if local.hour < 12 else local.date()


def shower_night(lat, lon, ra_deg, dec_deg, day, tz):
    start = datetime.combine(day, time(12, 0), tzinfo=tz).astimezone(timezone.utc)
    plan = plan_night(lat, lon, start)
    if not plan['darkness']:
        return {'day': day, 'max_alt': None, 'usable': 0, 'at': None, 'illum': 0}
    best, above = (-90, None), []
    for t in minute_range(*plan['darkness'], 5):
        ra, dec = precess(ra_deg, dec_deg, t)
        a = altitude(ra, dec, julian_day(t), lat, lon)
        best = max(best, (a, t), key=lambda x: x[0])
        above.append((t, a >= RADIANT_MIN_ALT))
    window = [t for t, up in above if up]
    usable = 0
    if window:
        w0, w1 = window[0], window[-1]
        usable = sum(max(0, (min(b, w1) - max(a, w0)).total_seconds() / 60) for a, b in plan['moon_free'])
        illum = phase_info(w0 + (w1 - w0) / 2)['fraction']
    else:
        illum = phase_info(plan['darkness'][0])['fraction']
    return {'day': day, 'max_alt': best[0], 'at': best[1], 'usable': round(usable), 'illum': illum,
            'observable': bool(window)}


def sky_events(lat, lon, day, tz_name, curated, days=30):
    tz = ZoneInfo(tz_name)
    start = datetime.combine(day, time(12, 0), tzinfo=tz).astimezone(timezone.utc)
    end = start + timedelta(days=days)
    out = []

    def add(t, kind, title, detail='', good=False):
        local = t.astimezone(tz)
        out.append({'at': t.isoformat(), 'date': local.strftime('%a %-d %b'), 'kind': kind,
                    'title': title, 'detail': detail, 'good': good})

    elong = lambda t: phase_info(t)['elongation']
    for t, name in angle_events(elong, [0, 90, 180, 270], ['New moon', 'First quarter', 'Full moon', 'Last quarter'],
                                start, end):
        add(t, 'moon', name, t.astimezone(tz).strftime('%H:%M'), name == 'New moon')
    sun_lon = lambda t: sun_position(julian_day(t))[0]
    names = (['March equinox', 'June solstice', 'September equinox', 'December solstice'] if lat >= 0 else
             ['Autumn equinox', 'Winter solstice', 'Spring equinox', 'Summer solstice'])
    for t, name in angle_events(sun_lon, [0, 90, 180, 270], names, start, end):
        add(t, 'season', name, t.astimezone(tz).strftime('%H:%M'))

    for e in curated:
        if e.get('kind') == 'meteor_shower' and e.get('peak_utc'):
            peak = datetime.fromisoformat(e['peak_utc'].replace('Z', '+00:00'))
            if not start - timedelta(days=1) <= peak <= end:
                continue
            ra, dec = e['radiant_ra_hours'] * 15, e['radiant_dec_deg']
            peak_day = evening_of(peak, tz)
            lo = date.fromisoformat(e['active_from']) if e.get('active_from') else peak_day
            hi = date.fromisoformat(e['active_to']) if e.get('active_to') else peak_day
            if peak_day < day and hi < day:
                continue
            past_peak = peak_day < day  # peaked already but still active: judge tonight instead
            night = shower_night(lat, lon, ra, dec, max(peak_day, day), tz)
            better = None
            for off in (-3, -2, -1, 1, 2, 3):
                d = night['day'] + timedelta(days=off)
                if lo <= d <= hi and d >= day:
                    n = shower_night(lat, lon, ra, dec, d, tz)
                    if n['usable'] > night['usable'] + 30 and (not better or n['usable'] > better['usable']):
                        better = n
            zhr = (' · past peak' if past_peak else '') + (f" · ZHR {e['zhr']}" if e.get('zhr') else '')
            if not night['observable']:
                detail, good = f'radiant stays below {RADIANT_MIN_ALT:.0f}° in the dark here', False
            else:
                best = night['at'].astimezone(tz).strftime('%H:%M')
                moon = f"moon {round(night['illum'] * 100)}%"
                detail = (f"radiant {night['max_alt']:.0f}° at {best} · {hm(night['usable'])} moon-free · {moon}")
                good = night['usable'] >= 60
            if better:
                detail += f" · better {better['day'].strftime('%a %-d')}: {hm(better['usable'])}"
            add(datetime.combine(night['day'], time(21, 0), tzinfo=tz), 'shower', e['name'] + zhr, detail, good)
        elif e.get('kind') in ('festival', 'other') and e.get('active_from'):
            a = date.fromisoformat(e['active_from'])
            b = date.fromisoformat(e.get('active_to') or e['active_from'])
            if a <= (end.astimezone(tz)).date() and b >= day:
                when = datetime.combine(max(a, day), time(12, 0), tzinfo=tz)
                span = a.strftime('%-d %b') + (f"–{b.strftime('%-d %b')}" if b != a else '')
                add(when, e['kind'], e['name'], ' · '.join(filter(None, [span, e.get('location', '')])))
    return sorted(out, key=lambda x: x['at'])


# ---- Exposure: NPF rule (Michaud) at the core's declination, and the 500 rule

def exposure(focal=None, aperture=None, pitch=None, crop=1.0):
    if not focal:
        return None
    out = {'focal': focal, 'aperture': aperture, 'rule500': round(500 / (focal * (crop or 1)), 1)}
    if aperture and pitch:
        out['npf'] = round((16.856 * aperture + 0.0997 * focal + 13.713 * pitch)
                           / (focal * math.cos(rad(GC_DEC_DEG))), 1)
    return out


def load_kp(now=None, with_fetched=False):
    now = now or datetime.now(timezone.utc)
    data, fetched = cached_json('kp-series.json', KP_URL, CACHE_TTL, now, lambda body: kp_rows(body, now))
    return (data, fetched) if with_fetched else data


def kp_rows(products, now):
    out = []
    for row in products:
        t = datetime.fromisoformat(row['time_tag']).replace(tzinfo=timezone.utc)
        if t >= now - timedelta(hours=24):
            out.append({'time': row['time_tag'], 'kp': round(float(row['kp']), 2),
                        'observed': row.get('observed') or '', 'scale': row.get('noaa_scale')})
    return out


def bar_output(report, sun=None, lat=None, lon=None, clouds=None, kp=None, aurora_kp=AURORA_KP,
               fetched=None, curated=None, optics=None, extras=True, mode="milky-way", now=None, location_name=None,
               kp_fetched=None, saved_locations=None):
    now = now or datetime.now(timezone.utc)
    if isinstance(fetched, dict):
        fetched = {**fetched, 'kp': kp_fetched}
    plan = report['_plan']
    moon = report['moon']
    free = report['moon_free_minutes']
    if report['verdict_class'] == 'none':
        night = f"{moon['glyph']} no dark"
    elif free >= MIN_MOON_FREE:
        night = f"{moon['glyph']} {free // 60}h{free % 60:02d}"
    else:
        night = f"{moon['glyph']} {moon['illumination_pct']}%"
    line = timeline(plan, lat, lon, clouds, kp) if lat is not None else None
    notes = []
    if line and line['cloud_pct'] is not None and line['cloud_pct'] >= CLOUDY_PCT:
        night += f' {CLOUD_GLYPH}'
        notes.append(f"Clouds {line['cloud_pct']}% through the dark hours")
    if line and line['kp_max'] is not None and line['kp_max'] >= aurora_kp:
        night += f' {AURORA_GLYPH}'
        notes.append(f"Aurora chance: Kp {line['kp_max']:.1f} forecast tonight (camera, {'north' if lat >= 0 else 'south'} horizon)")
    text = f"{sun['text']}  {night}" if sun else night
    shoot = (shoot_verdict(plan, report, lat, lon, clouds, fetched, line['kp_max'] if line else None, aurora_kp, now=now, mode=mode, curated=curated)
             if lat is not None else None)

    def clock(value):
        return datetime.fromisoformat(value).strftime('%H:%M') if value else '--'

    subject = target_windows(plan, lat, lon, mode, curated)[1] if lat is not None else report['verdict']
    summary_line = MODES[mode] + ' · ' + subject if lat is not None else report['verdict']
    lines = ([shoot['headline'], ''] if shoot else []) + ([sun['tooltip'], ''] if sun else []) + [
        summary_line,
        f"{moon['phase']}, {moon['illumination_pct']}% lit   rise {clock(moon['moonrise'])}   set {clock(moon['moonset'])}",
        *notes, '', 'Click for the night panel']
    out = {'text': text, 'tooltip': '\n'.join(lines), 'class': shoot['level'] if shoot else report['verdict_class']}
    if lat is not None:
        day = date.fromisoformat(report['date'])
        best = best_window(plan, report, lat, lon, clouds, fetched, kp, mode, curated, aurora_kp, now)
        tz_name = plan['tz'].key
        target = target_windows(plan, lat, lon, mode, curated)[0]
        selected_hours = hours_in(clouds, target)
        out['panel'] = {
            'date': report['date'], 'verdict': summary_line, 'mode': mode, 'mode_label': MODES[mode],
            'location': {**report['location'], 'name': location_name or f'{lat:.3f}, {lon:.3f}'},
            'best_window': best, 'saved_locations': saved_locations or [],
            'sources': {
                'clouds': source_status(source_time(fetched, 'clouds'), any(h.get('total') is not None for h in selected_hours), now),
                'haze': source_status(source_time(fetched, 'haze'), any(h.get('aod') is not None for h in selected_hours), now),
                'kp': source_status(kp_fetched, bool(kp), now)}, 'notes': notes, 'shoot': shoot,
            'moon': {**moon, 'moonrise': clock(moon['moonrise']), 'moonset': clock(moon['moonset'])},
            'moon_free_minutes': free, 'core_minutes': report['milky_way_core']['minutes'],
            'south': lat < 0, 'aurora_kp': aurora_kp,
            'timeline': line,
            'core_times': core_times(plan, lat, lon),
            'exposure': exposure(**optics) if optics else None,
            'week': week(lat, lon, day, clouds, fetched, tz_name, kp, aurora_kp, mode, curated, now) if extras else None,
            'events': sky_events(lat, lon, day, tz_name, curated or []) if extras else None,
            'fetched': source_time(fetched, 'clouds'),
        }
        place_line = f"{out['panel']['location']['name']} · {tz_name} · {MODES[mode]}"
        best_line = ('Best interval: ' + best['headline']) if best else 'No future usable interval'
        out['tooltip'] = place_line + '\n' + best_line + '\n\n' + out['tooltip']
    return out


def sun_report(lat, lon, now, tz_name=DEFAULT_TZ):
    """Today's sunrise/sunset, evening golden hour and the next sun event after `now`."""
    tz = ZoneInfo(tz_name)
    now = now.astimezone(tz)
    start = datetime.combine(now.date(), time(0), tzinfo=tz)
    end = start + timedelta(days=2)
    horizon = crossings(lambda t: sun_altitude(t, lat, lon) - SUN_HORIZON, start, end)
    golden = crossings(lambda t: sun_altitude(t, lat, lon) - GOLDEN_HOUR, start, end)
    rises = [t.astimezone(tz) for t, d in horizon if d > 0]
    sets = [t.astimezone(tz) for t, d in horizon if d < 0]
    today = now.date()
    rise = next((t for t in rises if t.date() == today), None)
    sunset = next((t for t in sets if t.date() == today), None)
    golden_start = next((t.astimezone(tz) for t, d in golden
                         if d < 0 and t.astimezone(tz).date() == today), None)
    upcoming = sorted([(t, 'sunrise') for t in rises if t > now] + [(t, 'sunset') for t in sets if t > now])
    hhmm = lambda t: t.strftime('%H:%M') if t else '--'
    nxt_t, nxt = upcoming[0] if upcoming else (None, None)
    glyph = '\U000F059C' if nxt == 'sunrise' else '\U000F059B'
    lines = [f'Sunrise {hhmm(rise)}   Sunset {hhmm(sunset)}']
    if rise and sunset:
        lines[0] += f'   ({hm(minutes((rise, sunset)))} of daylight)'
    if golden_start and sunset:
        lines.append(f'Golden hour {hhmm(golden_start)}-{hhmm(sunset)}')
    if nxt == 'sunrise' and nxt_t.date() != today:
        lines.append(f'Tomorrow\'s sunrise {hhmm(nxt_t)}')
    return {'sunrise': hhmm(rise), 'sunset': hhmm(sunset), 'golden_hour': hhmm(golden_start),
            'next': nxt, 'next_at': hhmm(nxt_t),
            'text': f'{glyph} {hhmm(nxt_t)}', 'tooltip': '\n'.join(lines)}


def current_night(lat, lon, now, tz_name=DEFAULT_TZ):
    """Before sunrise the night still in progress is last evening's; after it, tonight's."""
    last = tonight(lat, lon, now.date() - timedelta(days=1), tz_name)
    sunrise = last['_plan']['sunrise']
    return last if sunrise and now < sunrise else tonight(lat, lon, now.date(), tz_name)


def read_location():
    """The location set in Omarchy's weather panel, if it stored coordinates."""
    try:
        state = json.loads(OMARCHY_WEATHER.read_text())
        lat, lon = float(state['latitude']), float(state['longitude'])
        if -90 <= lat <= 90 and -180 <= lon <= 180:
            return lat, lon
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return None


def saved_places():
    try:
        items = json.loads(LOCATIONS.read_text())
        if not isinstance(items, list):
            return []
        return [validate_place(p['name'], p['lat'], p['lon'], p['tz']) for p in items]
    except (OSError, ValueError, KeyError, TypeError):
        return []


def validate_place(name, lat, lon, tz):
    lat, lon = float(lat), float(lon)
    if not name.strip() or len(name) > 80 or not -90 <= lat <= 90 or not -180 <= lon <= 180:
        raise ValueError('Enter a name and valid latitude / longitude.')
    try:
        ZoneInfo(tz)
    except (KeyError, ValueError):
        raise ValueError('Use an IANA time zone, such as America/Denver.') from None
    return {'name': name.strip(), 'lat': lat, 'lon': lon, 'tz': tz}


def write_places(places):
    LOCATIONS.parent.mkdir(parents=True, exist_ok=True)
    tmp = LOCATIONS.with_suffix('.tmp')
    tmp.write_text(json.dumps(places) + '\n')
    tmp.chmod(0o600)
    tmp.replace(LOCATIONS)


def main(argv=None):
    ap = argparse.ArgumentParser(description="Tonight's sky: moon, dark window and Milky Way core")
    ap.add_argument('--date', type=date.fromisoformat, help='evening date, YYYY-MM-DD (default today)')
    ap.add_argument('--lat', type=float)
    ap.add_argument('--lon', type=float)
    ap.add_argument('--tz', default=DEFAULT_TZ)
    ap.add_argument('--mode', choices=MODES, default='milky-way')
    ap.add_argument('--location-name')
    ap.add_argument('--saved-location')
    ap.add_argument('--save-location', help='save the supplied coordinates and time zone under this name')
    ap.add_argument('--remove-location', help='remove a saved place by name')
    ap.add_argument('--list-locations', action='store_true')
    ap.add_argument('--compare-locations', action='store_true', help='compare current and saved places for the same evening date')
    ap.add_argument('--bar', action='store_true', help='short JSON for the bar widget')
    ap.add_argument('--sun', action='store_true', help='next sunrise/sunset and golden hour as JSON')
    ap.add_argument('--offline', action='store_true', help='with --bar: skip the cloud and Kp fetches')
    ap.add_argument('--focal', type=float, help='lens focal length (mm) for the exposure helper')
    ap.add_argument('--aperture', type=float, help='f-number, e.g. 1.8')
    ap.add_argument('--pitch', type=float, help='sensor pixel pitch (µm)')
    ap.add_argument('--crop', type=float, default=1.0, help='crop factor (1 for full frame)')
    ap.add_argument('--aurora-kp', type=float, default=AURORA_KP, help='Kp that flags an aurora chance (default 6)')
    args = ap.parse_args(argv)
    places = saved_places()
    if args.list_locations:
        print(json.dumps(places))
        return
    if args.save_location or args.remove_location:
        try:
            if args.save_location:
                place = validate_place(args.save_location, args.lat, args.lon, args.tz)
                places = [p for p in places if p['name'] != place['name']] + [place]
            else:
                places = [p for p in places if p['name'] != args.remove_location]
            write_places(places)
            print(json.dumps({'saved_locations': places}))
        except (OSError, ValueError, TypeError) as e:
            print(json.dumps({'error': str(e)}))
        return
    if args.saved_location:
        place = next((p for p in places if p['name'] == args.saved_location), None)
        if place is None:
            ap.error('Saved location not found')
        args.lat, args.lon, args.tz, args.location_name = place['lat'], place['lon'], place['tz'], place['name']
    if (args.lat is None) != (args.lon is None):
        ap.error('--lat and --lon go together')
    here = (args.lat, args.lon) if args.lat is not None else read_location()
    if here is None:
        json.dump({'text': '\U000F0594 set location', 'class': 'none',
                   'tooltip': 'Night sky needs a location: set latitude and longitude in the widget '
                              "settings, or a location in Omarchy's weather panel."}, sys.stdout)
        print()
        return
    lat, lon = here
    if not -90 <= lat <= 90 or not -180 <= lon <= 180:
        ap.error('Latitude / longitude out of range')
    try:
        ZoneInfo(args.tz)
    except (KeyError, ValueError):
        ap.error('Invalid IANA time zone')
    if not args.location_name and args.lat is None:
        try:
            args.location_name = json.loads(OMARCHY_WEATHER.read_text()).get('name')
        except (OSError, ValueError):
            pass
    if args.compare_locations:
        now_utc = datetime.now(timezone.utc)
        evening = args.date or date.fromisoformat(current_night(lat, lon, now_utc.astimezone(ZoneInfo(args.tz)), args.tz)['date'])
        current = {'name': args.location_name or 'Current location', 'lat': lat, 'lon': lon, 'tz': args.tz}
        candidates = [current] + [p for p in places if p != current]
        curated = load_bundled_curated() if args.offline else load_curated()
        kp, kp_fetched = (None, None) if args.offline else load_kp(with_fetched=True)
        comparison = []
        for place in candidates:
            rep = tonight(place['lat'], place['lon'], evening, place['tz'])
            hours, fetched = (None, None) if args.offline else load_conditions(place['lat'], place['lon'])
            out = bar_output(rep, lat=place['lat'], lon=place['lon'], clouds=hours, kp=kp,
                             aurora_kp=args.aurora_kp, fetched=fetched, curated=curated, extras=False,
                             mode=args.mode, now=now_utc, kp_fetched=kp_fetched, location_name=place['name'])
            panel = out['panel']
            comparison.append({'location': panel['location'], 'date': panel['date'], 'shoot': panel['shoot'],
                               'best_window': panel['best_window'], 'sources': panel['sources']})
        print(json.dumps({'comparison': comparison}, ensure_ascii=False))
        return
    if args.sun:
        now = datetime.now(ZoneInfo(args.tz))
        if args.date:
            now = datetime.combine(args.date, time(12, 0), tzinfo=ZoneInfo(args.tz))
        json.dump(sun_report(lat, lon, now, args.tz), sys.stdout, ensure_ascii=False)
        print()
        return
    now = datetime.now(ZoneInfo(args.tz))
    if args.date:
        report = tonight(lat, lon, args.date, args.tz)
        now = datetime.combine(args.date, time(12, 0), tzinfo=ZoneInfo(args.tz))
    else:
        report = current_night(lat, lon, now, args.tz)
    if args.bar:
        hours, fetched = (None, None) if args.offline else load_conditions(lat, lon)
        kp, kp_fetched = (None, None) if args.offline else load_kp(with_fetched=True)
        optics = {'focal': args.focal, 'aperture': args.aperture, 'pitch': args.pitch, 'crop': args.crop}
        out = bar_output(report, sun_report(lat, lon, now, args.tz), lat, lon, hours, kp, args.aurora_kp,
                         fetched, load_curated() if not args.offline else load_bundled_curated(),
                         optics if args.focal else None, mode=args.mode, location_name=args.location_name,
                         kp_fetched=kp_fetched, saved_locations=places)
    else:
        out = {k: v for k, v in report.items() if k != '_plan'}
    json.dump(out, sys.stdout, indent=None if args.bar else 2, ensure_ascii=False)
    print()


if __name__ == '__main__':
    main()
